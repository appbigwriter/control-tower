# Shared Supabase connection used by Control Tower, BigHead and Hermes
SUPABASE_URL=https://supabase.fbr.news
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://supabase.fbr.news
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Control Tower
CONTROL_TOWER_ADMIN_SECRET=
NEXT_PUBLIC_APP_NAME=Control Tower

# BigHead SaaS
BIGHEAD_APP_NAME=BigHead
BIGHEAD_SUPABASE_URL=https://supabase.fbr.news
BIGHEAD_SUPABASE_SERVICE_ROLE_KEY=

# Hermes runtime
HERMES_HOME=/opt/data/.hermes
HERMES_WORKSPACE=/opt/data/workspace
HERMES_PROFILES_DIR=/opt/data/workspace
