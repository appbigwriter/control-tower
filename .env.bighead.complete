# BigHead - production template
# Fill only the real values used by the SaaS.

# Shared Supabase
SUPABASE_URL=https://supabase.fbr.news
SUPABASE_ANON_KEY=<bighead-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<bighead-supabase-service-role-key>
NEXT_PUBLIC_SUPABASE_URL=https://supabase.fbr.news
NEXT_PUBLIC_SUPABASE_ANON_KEY=<bighead-public-anon-key>

# Session / auth
SESSION_SECRET=<strong-session-secret>
SESSION_COOKIE_NAME=bighead_session

# API / backend
BACKEND_URL=http://backend:8000
INTERNAL_API_KEY=<internal-api-key>
ALLOWED_ORIGINS=https://bighead.fbr.news,https://www.bighead.fbr.news
ENVIRONMENT=production
PORT=8000

# Cache / jobs
REDIS_URL=redis://redis:6379/0
MAX_UPLOAD_SIZE_MB=50

# OpenClaw / AI
OPENCLAW_GATEWAY_URL=<openclaw-gateway-url>
OPENCLAW_API_KEY=<openclaw-api-key>
OPENCLAW_WEBHOOK_KEY=<openclaw-webhook-key>
OPENAI_API_KEY=<openai-api-key-if-bighead-uses-it>

# Image integrations
UNSPLASH_ACCESS_KEY=<unsplash-access-key>
PEXELS_API_KEY=<pexels-api-key>

# N8N
N8N_WEBHOOK_URL=<n8n-webhook-url>
N8N_API_KEY=<n8n-api-key>
N8N_WEBHOOK_KEY=<n8n-webhook-key>

# Multi-tenant
DEFAULT_PUBLICATION_SLUG=<default-publication-slug>

# App
NEXT_PUBLIC_APP_NAME=BigHead
NEXT_PUBLIC_APP_URL=https://bighead.fbr.news

# BigHead aliases
BIGHEAD_SUPABASE_URL=https://supabase.fbr.news
BIGHEAD_SUPABASE_SERVICE_ROLE_KEY=<same-as-service-role-key-or-separate-alias>

# Hermes runtime shared with BigHead
HERMES_HOME=/opt/data/.hermes
HERMES_WORKSPACE=/opt/data/workspace
HERMES_PROFILES_DIR=/opt/data/workspace

# Hermes dashboard/runtime behavior
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_TUI=1
HERMES_SERVER_DOMAIN=
HERMES_SETUP_GITHUB_USER=
HERMES_API_TIMEOUT=1800
HERMES_API_CALL_STALE_TIMEOUT=300
