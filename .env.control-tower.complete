# Control Tower - production template
# Fill only the real values used by this service.

SUPABASE_URL=https://supabase.fbr.news
SUPABASE_SERVICE_ROLE_KEY=<control-tower-service-role-key>
CONTROL_TOWER_ADMIN_SECRET=<strong-admin-secret>
NEXT_PUBLIC_APP_NAME=Control Tower

# Optional if the app exposes public Supabase reads
NEXT_PUBLIC_SUPABASE_URL=https://supabase.fbr.news
NEXT_PUBLIC_SUPABASE_ANON_KEY=<control-tower-anon-key>

# Optional runtime metadata
NEXT_PUBLIC_APP_URL=https://control-tower.fbr.news
