# Supabase self-hosted — VPS2 / Easypanel
#
# Este arquivo é um TEMPLATE. Não coloque valores reais no Git.
# Preencha os placeholders no Environment do serviço supabase-gestaodb.
#
# Regra de rede:
# - Estas variáveis são usadas DENTRO do Compose Supabase.
# - POSTGRES_HOST deve ser o serviço Docker `db`.
# - POSTGRES_PORT deve ser a porta interna 5432.
# - Clientes externos usam o proxy TCP da VPS em 76.13.168.223:15432.

############
# URLs públicas
############

SUPABASE_PUBLIC_URL=https://supabase-control-tower.fbr.news
API_EXTERNAL_URL=https://supabase-control-tower-api.fbr.news
SITE_URL=https://supabase-control-tower.fbr.news
ADDITIONAL_REDIRECT_URLS=https://supabase-control-tower.fbr.news/**

############
# Database — interno ao Compose
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=<ROTATE_AND_SET_POSTGRES_PASSWORD>

############
# Supavisor
############

# Identificador estável do tenant do pooler; não é senha.
POOLER_TENANT_ID=supabase-vps2

# Porta interna de session mode.
# O Supabase usa POSTGRES_PORT=5432 internamente.
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

############
# API keys e JWT
############

ANON_KEY=<GENERATE_SUPABASE_ANON_KEY>
SERVICE_ROLE_KEY=<GENERATE_SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_PUBLISHABLE_KEY=<GENERATE_SUPABASE_PUBLISHABLE_KEY>
SUPABASE_SECRET_KEY=<GENERATE_SUPABASE_SECRET_KEY>
SUPABASE_URL=http://kong:8000
JWT_SECRET=<GENERATE_LONG_RANDOM_JWT_SECRET>
JWT_KEYS=<GENERATE_AUTH_JWK_SET>
JWT_JWKS=<GENERATE_AUTH_JWKS>
JWT_EXPIRY=3600

############
# Dashboard / Studio
############

DASHBOARD_USERNAME=<SET_DASHBOARD_USERNAME>
DASHBOARD_PASSWORD=<SET_DASHBOARD_PASSWORD>
STUDIO_DEFAULT_ORGANIZATION=FBR
STUDIO_DEFAULT_PROJECT=FBR Central Supabase

############
# Postgres Meta / Supavisor / Realtime
############

PG_META_CRYPTO_KEY=<GENERATE_LONG_RANDOM_PG_META_KEY>
SECRET_KEY_BASE=<GENERATE_LONG_RANDOM_SECRET_KEY_BASE>
VAULT_ENC_KEY=<GENERATE_LONG_RANDOM_VAULT_KEY>

############
# PostgREST / runtime
############

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000
FUNCTIONS_VERIFY_JWT=true

############
# Auth
############

DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# SMTP — preencher se Auth enviar e-mail
############

SMTP_ADMIN_EMAIL=<SMTP_ADMIN_EMAIL>
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<SMTP_USER>
SMTP_PASS=<SMTP_PASSWORD>
SMTP_SENDER_NAME=FBR Supabase
SMTP_SECURE=true

############
# Analytics / Vector
############

LOGFLARE_PUBLIC_ACCESS_TOKEN=<GENERATE_LOGFLARE_PUBLIC_TOKEN>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<GENERATE_LOGFLARE_PRIVATE_TOKEN>
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

############
# Storage / S3 — somente se usado
############

GLOBAL_S3_BUCKET=<GLOBAL_S3_BUCKET>
STORAGE_TENANT_ID=<STORAGE_TENANT_ID>
S3_PROTOCOL_ACCESS_KEY_ID=<GENERATE_S3_ACCESS_KEY_ID>
S3_PROTOCOL_ACCESS_KEY_SECRET=<GENERATE_S3_ACCESS_KEY_SECRET>

############
# Imagem / região
############

IMGPROXY_AUTO_WEBP=true
REGION=local
OPENAI_API_KEY=<OPTIONAL_OPENAI_API_KEY>
GOOGLE_PROJECT_ID=<OPTIONAL_GOOGLE_PROJECT_ID>
GOOGLE_PROJECT_NUMBER=<OPTIONAL_GOOGLE_PROJECT_NUMBER>

############
# Conexão externa dos demais projetos
############

# NÃO colocar estas variáveis como POSTGRES_HOST/POSTGRES_PORT internos.
# Depois que o proxy TCP estiver ativo, os clientes externos usam:
#
# DATABASE_URL=postgresql://postgres.supabase-vps2:<POSTGRES_PASSWORD>@76.13.168.223:15432/postgres
#
# Usuário externo: postgres.supabase-vps2
# Host externo: 76.13.168.223
# Porta externa: 15432
# Banco: postgres
